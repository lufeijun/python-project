{
  "database_name": "company",
  "tables": [
    {
      "table_name": "employees",
      "description": "存储公司员工信息",
      "columns": [
        {"name": "id", "type": "INT", "description": "员工唯一ID"},
        {"name": "name", "type": "VARCHAR(100)", "description": "员工姓名"},
        {"name": "department", "type": "VARCHAR(50)", "description": "所属部门"},
        {"name": "salary", "type": "DECIMAL(10,2)", "description": "月薪"}
      ]
    },
    {
      "table_name": "departments",
      "description": "存储部门信息",
      "columns": [
        {"name": "id", "type": "INT", "description": "部门ID"},
        {"name": "name", "type": "VARCHAR(50)", "description": "部门名称"},
        {"name": "location", "type": "VARCHAR(100)", "description": "办公地点"}
      ]
    }
  ],
  "relationships": [
    {
      "table1": "employees",
      "table2": "departments",
      "join_condition": "employees.department = departments.name"
    }
  ]
}